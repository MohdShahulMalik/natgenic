---
import Placeholder from './Placeholder.astro';
---
<section id="product-intro">
  <div class="wrap split">
    <div class="reveal">
      <p class="eyebrow">Introducing</p>
      <h2 class="h-lg">Meet Natgenic</h2>
      <div class="divider" style="margin-top:28px"></div>
      <p class="lead">
        Natgenic is a results-focused hair oil created for people who want a
        dedicated hair-care routine for hair fall, thinning and genetic hair loss.
      </p>
      <ul class="meet-list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          <span>A concentrated formulation with a clear, single purpose.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          <span>Built to fit into a consistent routine, not positioned as an instant miracle solution.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          <span>Backed by real customers showing their own progress over time.</span>
        </li>
      </ul>
      <a class="link-cta" href="#results">Explore Natgenic <span class="arw">&rarr;</span></a>
    </div>
    <div class="meet-stage reveal">
      <Placeholder
        id="IMG-MEET-BOTTLE"
        label="Natgenic bottle — angled / clinical product shot"
        hint="Neutral background, minimal props. Portrait 4:5 ~1200×1500px"
        variant="ph--tall"
      />
    </div>
  </div>
</section>
