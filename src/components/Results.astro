---
import Placeholder from './Placeholder.astro';

interface Result {
  customer: string;
  beforeId: string;
  afterId: string;
}

const RESULTS: Result[] = [
  { customer: 'Customer 1', beforeId: 'IMG-BA-1-BEFORE', afterId: 'IMG-BA-1-AFTER' },
  { customer: 'Customer 2', beforeId: 'IMG-BA-2-BEFORE', afterId: 'IMG-BA-2-AFTER' },
  { customer: 'Customer 3', beforeId: 'IMG-BA-3-BEFORE', afterId: 'IMG-BA-3-AFTER' },
];
---
<section id="results">
  <div class="wrap">
    <div class="center reveal">
      <p class="eyebrow">Real Results</p>
      <h2 class="h-lg">Real People. Real Progress.</h2>
      <div class="divider" style="margin-top:28px"></div>
      <p class="lead">
        Don&rsquo;t just take our word for it. See the results shared by real
        customers who followed the routine consistently.
      </p>
    </div>

    <div class="results-grid">
      {RESULTS.map((result) => (
        <article class="result reveal">
          <div class="ba">
            <div class="ba-cell">
              <span class="ba-tag">Before</span>
              <Placeholder
                id={result.beforeId}
                label={`${result.customer}: before`}
                hint="Same angle & lighting as the after shot. 3:4"
                variant="ph--portrait"
              />
            </div>
            <div class="ba-cell">
              <span class="ba-tag after">After</span>
              <Placeholder
                id={result.afterId}
                label={`${result.customer}: after`}
                hint="Day 60. Keep authentic, minimal editing. 3:4"
                variant="ph--portrait"
              />
            </div>
          </div>
          <div class="result-foot">
            <strong>Before &rarr; After</strong>
            <span>60 Days</span>
          </div>
        </article>
      ))}
    </div>

    <div class="subhead-row reveal">
      <h3>In their own words.</h3>
      <p>Video testimonials from Natgenic customers.</p>
    </div>

    <div class="video-grid">
      <article class="video-card reveal">
        <Placeholder
          id="VID-TESTIMONIAL-1"
          label="Customer video testimonial 1"
          hint="MP4 + poster frame. Vertical 9:16 works best for Instagram-sourced clips."
          variant="ph--video"
        />
        <div class="vc-foot">
          <strong>Customer Testimonial</strong>
          <p>Shared after completing the 60-day routine.</p>
        </div>
      </article>
      <article class="video-card reveal">
        <Placeholder
          id="VID-TESTIMONIAL-2"
          label="Customer video testimonial 2"
          hint="MP4 + poster frame. Vertical 9:16."
          variant="ph--video"
        />
        <div class="vc-foot">
          <strong>Customer Testimonial</strong>
          <p>Shared after completing the 60-day routine.</p>
        </div>
      </article>
    </div>

    <p class="results-note">
      All photographs and videos are shared by real Natgenic customers with their
      permission. Results vary from person to person and depend on consistency,
      individual hair type and underlying causes of hair loss.
    </p>
  </div>
</section>
